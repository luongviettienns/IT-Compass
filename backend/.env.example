PORT=5000
DATABASE_URL="mysql://it_compass_app:change-me@localhost:3306/it_compass_vi"
FRONTEND_URL="http://localhost:5173"

# Auth
# Production phải dùng HTTPS FRONTEND_URL, JWT secret mạnh và COOKIE_SECURE=true.
JWT_ACCESS_SECRET="change-me-in-production"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
AUTH_DEBUG_EXPOSE_TOKENS=true
REFRESH_TOKEN_COOKIE_NAME="it_compass_refresh"
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS (comma-separated additional origins)
ALLOWED_ORIGINS=
# Chỉ IP/CIDR của reverse proxy thực tế; trống = không tin forwarded headers.
# Không dùng true / số hops / toàn mạng. Proxy phải overwrite forwarded headers.
TRUSTED_PROXIES=

# Upload
UPLOAD_MAX_FILE_SIZE_MB=5
REQUEST_BODY_LIMIT="1mb"

# Metrics: thiếu token => endpoint bị tắt (404); token sai/thiếu => 403.
METRICS_TOKEN=

# Redis: bật mà thiếu URL/lỗi kết nối => protected requests trả 503.
# Chỉ tắt Redis rõ ràng cho local hoặc một instance; memory không chia sẻ quota.
REDIS_URL=
RATE_LIMIT_USE_REDIS=false
